# Browser-safe base URL for the approved deployed Backend. The API namespace
# must remain /api/v1. Set a deployment-specific value when the Admin origin
# differs, and make sure that origin is approved for credentialed CORS.
NEXT_PUBLIC_API_BASE_URL=https://api.tareeq-academy.com/api/v1

# Server-only base URL. Never prefix this variable with NEXT_PUBLIC_.
API_BASE_URL=https://api.tareeq-academy.com/api/v1

# Development-only local Dashboard access. Leave disabled for normal and all
# production deployments. The server also ignores this value in production.
# ADMIN_DEV_MOCK_ACCESS=enabled
